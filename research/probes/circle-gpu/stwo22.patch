+impl crate::prover::vcs_lifted::ops::PackLeavesOps for CudaBackend {
+    fn pack_leaves_input(values: &[&BaseFieldVec; 4]) -> [BaseFieldVec; 16] {
+        let n = values[0].len();
+        assert!(n >= 4 && values.iter().all(|c| c.len() == n));
+        let result = std::array::from_fn(|_| BaseFieldVec::new_uninitialized(n / 4));
+        unsafe {
+            let inputs = values.map(|c| c.device_ptr);
+            let outputs: [*const u32; 16] = std::array::from_fn(|i| result[i].device_ptr);
+            bindings::hallmark_pack(inputs.as_ptr(), outputs.as_ptr(), n as u32);
+        }
+        result
+    }
+}
