+impl crate::prover::poly::twiddles::TwiddleBuffer<BitReversedOrder> for BaseFieldVec {
+    fn empty() -> Self { Self::new_uninitialized(0) }
+    fn extract_subdomain_twiddles(&self, domain_log_size: u32, subdomain_log_size: u32) -> Self {
+        let k = self.size.ilog2();
+        assert!(subdomain_log_size <= domain_log_size && domain_log_size - 1 <= k);
+        let size = 1usize << (subdomain_log_size - 1);
+        let out = Self::new_uninitialized(size);
+        let mut offset = 0;
+        for layer in 0..subdomain_log_size - 1 {
+            let start = self.size - (self.size >> (k - domain_log_size + 1 + layer));
+            let len = size >> (layer + 1);
+            unsafe { bindings::copy_uint32_t_vec_from_device_to_device(self.device_ptr.add(start), out.device_ptr.add(offset), len as u32); }
+            offset += len;
+        }
+        unsafe { bindings::copy_uint32_t_vec_from_device_to_device(self.device_ptr.add(self.size - 1), out.device_ptr.add(size - 1), 1); }
+        out
+    }
+}
