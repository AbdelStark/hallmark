@@ -0,0 +1,28 @@
+package main
+
+import (
+    "encoding/json"
+    "os"
+    "time"
+)
+
+// Timing-only benchmark overlay; the canonical classifier sources are unchanged.
+type classifierMeasurement struct {
+    action string
+    last time.Time
+    stages map[string]float64
+}
+func newClassifierMeasurement(action string) *classifierMeasurement {
+    return &classifierMeasurement{action, time.Now(), make(map[string]float64)}
+}
+func (m *classifierMeasurement) tick(name string) {
+    now := time.Now()
+    m.stages[name] = now.Sub(m.last).Seconds()
+    m.last = now
+}
+func (m *classifierMeasurement) emit() {
+    json.NewEncoder(os.Stderr).Encode(map[string]any{
+        "schema_id": "hallmark.gnark-benchmark-timing/1",
+        "action": m.action, "stages_seconds": m.stages,
+    })
+}
