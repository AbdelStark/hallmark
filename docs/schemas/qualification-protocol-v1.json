{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "description": "Exact bytes at a normalized relative POSIX path; parsing performs no I/O.",
      "properties": {
        "path": {
          "description": "Relative POSIX path, at most 4096 UTF-8 bytes; no normalization or links.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "QualificationLimits": {
      "additionalProperties": false,
      "properties": {
        "case_cpu_seconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Case Cpu Seconds",
          "type": "integer"
        },
        "case_seconds": {
          "maximum": 120,
          "minimum": 1,
          "title": "Case Seconds",
          "type": "integer"
        },
        "max_output_bytes": {
          "maximum": 21474836480,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_worker_rss_bytes": {
          "maximum": 17179869184,
          "minimum": 1048576,
          "title": "Max Worker Rss Bytes",
          "type": "integer"
        },
        "threads": {
          "maximum": 4,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "total_seconds": {
          "maximum": 7200,
          "minimum": 1,
          "title": "Total Seconds",
          "type": "integer"
        },
        "verify_seconds": {
          "maximum": 60,
          "minimum": 1,
          "title": "Verify Seconds",
          "type": "integer"
        }
      },
      "required": [
        "total_seconds",
        "case_seconds",
        "verify_seconds",
        "case_cpu_seconds",
        "threads",
        "max_worker_rss_bytes",
        "max_output_bytes"
      ],
      "title": "QualificationLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An externally approved run plan, not proof of approval or qualification.",
  "properties": {
    "authorization": {
      "$ref": "#/$defs/FileRef"
    },
    "binary": {
      "$ref": "#/$defs/FileRef"
    },
    "block_fixture": {
      "$ref": "#/$defs/FileRef"
    },
    "build_record": {
      "$ref": "#/$defs/FileRef"
    },
    "controller_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Controller Sha256",
      "type": "string"
    },
    "dependency_review": {
      "$ref": "#/$defs/FileRef"
    },
    "host": {
      "const": "macos-arm64",
      "title": "Host",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/QualificationLimits"
    },
    "mlp_fixture": {
      "$ref": "#/$defs/FileRef"
    },
    "rule_fixture": {
      "$ref": "#/$defs/FileRef"
    },
    "schema_id": {
      "const": "hallmark/qualification-protocol/1",
      "title": "Schema Id",
      "type": "string"
    },
    "source_review": {
      "$ref": "#/$defs/FileRef"
    }
  },
  "required": [
    "schema_id",
    "host",
    "controller_sha256",
    "binary",
    "rule_fixture",
    "mlp_fixture",
    "block_fixture",
    "source_review",
    "dependency_review",
    "build_record",
    "authorization",
    "limits"
  ],
  "title": "QualificationProtocol",
  "type": "object"
}
