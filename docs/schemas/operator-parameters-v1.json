      "$ref": "#/$defs/PlainParameters"
    },
    {
      "$ref": "#/$defs/GatherParameters"
    },
    {
      "$ref": "#/$defs/MultiplyParameters"
    },
    {
      "$ref": "#/$defs/TransposeParameters"
    },
    {
      "$ref": "#/$defs/ReductionParameters"
    },
    {
      "$ref": "#/$defs/LookupParameters"
    }
  ]
