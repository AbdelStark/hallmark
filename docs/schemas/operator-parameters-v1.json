  "discriminator": {
    "mapping": {
      "add": "#/$defs/PlainParameters",
      "affine": "#/$defs/PlainParameters",
      "gather": "#/$defs/GatherParameters",
      "lookup": "#/$defs/LookupParameters",
      "masked-reduce": "#/$defs/ReductionParameters",
      "multiply": "#/$defs/MultiplyParameters",
      "relu": "#/$defs/PlainParameters",
      "reshape": "#/$defs/PlainParameters",
      "transpose": "#/$defs/TransposeParameters"
