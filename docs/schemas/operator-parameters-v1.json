        "op": {
          "const": "gather",
          "title": "Op",
          "type": "string"
        },
        "schema_id": {
          "const": "hallmark/operator-parameters/1",
          "title": "Schema Id",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "op",
        "axis"
      ],
      "title": "GatherParameters",
      "type": "object"
    },
    "LookupParameters": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "title": "Offset",
          "type": "integer"
        },
        "op": {
          "const": "lookup",
          "title": "Op",
          "type": "string"
        },
        "schema_id": {
          "const": "hallmark/operator-parameters/1",
