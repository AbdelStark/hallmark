{
  "$defs": {
    "Case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "evidence_class": {
          "enum": [
            "software-vector",
            "real-proof",
            "real-hardware",
            "hybrid"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/Outcome"
        },
        "expected_request": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Expected Request",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "maxItems": 16,
          "title": "Inputs",
          "type": "array"
        },
        "mutation": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mutation"
        },
        "now": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Now",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "requirement": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
          "title": "Requirement",
          "type": "string"
        },
        "schema_id": {
          "const": "hallmark/conformance-case/1",
          "title": "Schema Id",
          "type": "string"
        },
        "trust": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Trust",
          "type": "string"
        },
        "unavailable": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unavailable",
          "type": "array"
        }
      },
      "required": [
        "schema_id",
        "case_id",
        "parent",
        "mutation",
        "evidence_class",
        "check",
        "inputs",
        "trust",
        "expected_request",
        "now",
        "expected",
        "requirement",
        "unavailable"
      ],
      "title": "Case",
      "type": "object"
    },
    "Check": {
      "enum": [
        "wire",
        "wire-small",
        "domains",
        "model",
        "model-files",
        "classifier",
        "input-profile",
        "policy",
        "request",
        "opening",
        "input-bytes",
        "proof-fields",
        "proof-profile",
        "receipt",
        "proof-declaration",
        "bundle",
        "enrollment",
        "entry-time",
        "rotation",
        "arithmetic",
        "linear",
        "diagnostic",
        "unavailable"
      ],
      "type": "string"
    },
    "ErrorCode": {
      "enum": [
        "INPUT_INVALID",
        "LIMIT_EXCEEDED",
        "TRUST_MISSING",
        "REGISTRY_INVALID",
        "ARTIFACT_RETIRED",
        "REQUEST_MISMATCH",
        "STALE_EVIDENCE",
        "SIGNATURE_INVALID",
        "ATTESTATION_INVALID",
        "MEASUREMENT_UNKNOWN",
        "OPENING_FAILED",
        "INPUT_BINDING_FAILED",
        "PROOF_INVALID",
        "VERDICT_MISMATCH",
        "POLICY_BLOCKED",
        "PROOF_PENDING",
        "RESOURCE_EXHAUSTED",
        "STORAGE_FAILED",
        "INTERNAL_ERROR"
      ],
      "type": "string"
    },
    "FileRef": {
      "additionalProperties": false,
      "description": "Exact bytes at a normalized relative POSIX path; parsing performs no I/O.",
      "properties": {
        "path": {
          "description": "Relative POSIX path, at most 4096 UTF-8 bytes; no normalization or links.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "description": "accepted means the named component check, never combined evidence acceptance.",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "claim_a": {
          "enum": [
            "accepted",
            "rejected",
            "not-accepted"
          ],
          "title": "Claim A",
          "type": "string"
        },
        "claim_b": {
          "enum": [
            "accepted",
            "rejected",
            "not-accepted"
          ],
          "title": "Claim B",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_digests": {
          "items": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Input Digests",
          "type": "array"
        },
        "integers": {
          "items": {
            "maximum": 18446744073709551615,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "maxItems": 4096,
          "title": "Integers",
          "type": "array"
        }
      },
      "required": [
        "accepted",
        "claim_a",
        "claim_b",
        "code",
        "input_digests",
        "integers"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
          "title": "Locator",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FileRef"
        }
      },
      "required": [
        "id",
        "source",
        "locator"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/Case"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "evidence_notice": {
      "const": "public-synthetic-fixtures-only",
      "title": "Evidence Notice",
      "type": "string"
    },
    "expectations": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Expectations",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "revision": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_id": {
      "const": "hallmark/conformance-corpus/1",
      "title": "Schema Id",
      "type": "string"
    },
    "trust_policies": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Trust Policies",
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "revision",
    "evidence_notice",
    "trust_policies",
    "expectations",
    "requirements",
    "cases"
  ],
  "title": "Corpus",
  "type": "object"
}
